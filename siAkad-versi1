                                    {subjects.map(s => <option key={s.id} value={s.id}>{s.name}</option>)}
                                </select>
                            </div>
                            <div className="flex gap-2 w-full md:w-auto mt-2 md:mt-0">
                                <Button onClick={() => setShowForm(true)} icon="Plus" variant="primary">Buat Agenda Penilaian</Button>
                                <Button onClick={() => window.print()} icon="Printer" variant="secondary" className="hidden md:flex">Cetak</Button>
                            </div>
                        </Card>
                    </div>

