        const ReportManager = ({ students, subjects, grades, attendance, schoolData, assessments }) => {
            const printRef = useRef();
            const countAttendance = (sid) => { let h=0,s=0,i=0,a=0; Object.values(attendance).forEach(d => { if(d[sid]==='H')h++; if(d[sid]==='S')s++; if(d[sid]==='I')i++; if(d[sid]==='A')a++; }); return {h,s,i,a}; }
            
            const calcAvgType = (sid, subId, type) => {
                const relevant = assessments.filter(a => a.subjectId === subId && a.type === type);
                if (relevant.length === 0) return 0;
                let total = 0, count = 0;
                relevant.forEach(a => { const score = parseFloat(grades[sid]?.[a.id]); if (!isNaN(score)) { total += score; count++; } });
                return count === 0 ? 0 : (total / count);
            };

            const calcScore = (sid, subId) => { 
                const harian = calcAvgType(sid, subId, 'harian');
                const tugas = calcAvgType(sid, subId, 'tugas');
                const pts = calcAvgType(sid, subId, 'pts');
                const pas = calcAvgType(sid, subId, 'pas');

                let final = (harian * 0.30) + (tugas * 0.20) + (pts * 0.20) + (pas * 0.30);
                if (isNaN(final)) final = 0;
                return Math.round(final);
            }

            return (
                <div className="space-y-6 pb-20">
                    <div className="no-print flex gap-2 justify-end"><Button onClick={() => window.print()} icon="Printer">Cetak Raport PDF</Button></div>
