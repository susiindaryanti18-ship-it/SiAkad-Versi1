                            </div>
                        </div>

                        <Card className="p-3 shadow-sm flex flex-col md:flex-row justify-between items-center gap-4">
                            <div className="flex-1 w-full md:w-auto">
                                <label className="text-xs font-bold text-slate-500 uppercase ml-1 mb-1 block">Filter Mata Pelajaran:</label>
