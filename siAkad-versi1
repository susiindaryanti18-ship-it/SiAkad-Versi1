                            {activeTab === 'lessonPlan' && <LessonPlanManager lessonPlans={lessonPlans} setLessonPlans={setLessonPlans} subjects={subjects} schoolData={schoolData} />}
                            {activeTab === 'attendance' && <AttendanceManager attendance={attendance} setAttendance={setAttendance} students={students} />}
                            {activeTab === 'grades' && <GradeManager grades={grades} setGrades={setGrades} students={students} subjects={subjects} assessments={assessments} setAssessments={setAssessments} schoolData={schoolData} />}
                            {activeTab === 'journal' && <JournalManager lessonPlans={lessonPlans} attendance={attendance} students={students} subjects={subjects} schoolData={schoolData} />}
                            {activeTab === 'report' && <ReportManager students={students} subjects={subjects} grades={grades} attendance={attendance} schoolData={schoolData} assessments={assessments} />}
                            {activeTab === 'data' && <DataManager schoolData={schoolData} setSchoolData={setSchoolData} students={students} setStudents={setStudents} subjects={subjects} setSubjects={setSubjects} attendance={attendance} setAttendance={setAttendance} assessments={assessments} setAssessments={setAssessments} grades={grades} setGrades={setGrades} lessonPlans={lessonPlans} setLessonPlans={setLessonPlans} schedule={schedule} />}
                        </div>
                    </main>
                </div>
            );
        }

        const root = ReactDOM.createRoot(document.getElementById('root'));
        root.render(<App />);
    </script>
</body>
</html>
