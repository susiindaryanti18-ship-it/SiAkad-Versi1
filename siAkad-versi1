<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>SiAkad Guru - Cloud Version</title>
    
    <script src="https://unpkg.com/react@18/umd/react.production.min.js"></script>
    <script src="https://unpkg.com/react-dom@18/umd/react-dom.production.min.js"></script>
    <script src="https://unpkg.com/@babel/standalone/babel.min.js"></script>
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://unpkg.com/lucide-react"></script>

    <script src="https://www.gstatic.com/firebasejs/9.1.3/firebase-app-compat.js"></script>
    <script src="https://www.gstatic.com/firebasejs/9.1.3/firebase-database-compat.js"></script>

    <style>
        @media print {
            .no-print { display: none !important; }
            .print-input { border: none !important; background: transparent !important; }
        }
        .custom-scrollbar::-webkit-scrollbar { width: 6px; }
        .custom-scrollbar::-webkit-scrollbar-thumb { background: #cbd5e1; border-radius: 10px; }
    </style>
</head>
<body class="bg-slate-50 text-slate-900">
    <div id="root"></div>

    <script type="text/babel">
        const { useState, useEffect } = React;
        const Icons = lucide;

        // KONFIGURASI FIREBASE ANDA
        const firebaseConfig = {
            apiKey: "AIzaSyBTdEN-oa5uAxcZVfcpdKOG35bsJaARbio",
            authDomain: "siakad-guru.firebaseapp.com",
            projectId: "siakad-guru",
            storageBucket: "siakad-guru.firebasestorage.app",
            messagingSenderId: "927647714061",
            appId: "1:927647714061:web:8e424e66cd780cb0ce3e44",
            databaseURL: "https://siakad-guru-default-rtdb.firebaseio.com" // Sesuaikan dengan URL Database Anda
        };

        // Inisialisasi Firebase
        if (!firebase.apps.length) {
            firebase.initializeApp(firebaseConfig);
        }
        const db = firebase.database();

        // --- Komponen UI Reusable ---
        const Card = ({ children, title, icon: Icon }) => (
            <div class="bg-white rounded-2xl shadow-sm border border-slate-200 overflow-hidden mb-6">
                {title && (
                    <div class="px-6 py-4 border-b border-slate-100 flex items-center gap-3 bg-slate-50/50">
                        {Icon && <Icon size={20} class="text-violet-600" />}
                        <h3 class="font-bold text-slate-800">{title}</h3>
                    </div>
                )}
                <div class="p-6">{children}</div>
            </div>
        );

        // --- Komponen Utama ---
        const App = () => {
            const [activeTab, setActiveTab] = useState('profile');
            const [loading, setLoading] = useState(true);
            const [schoolData, setSchoolData] = useState({
                name: "SD NEGERI 1 CONTOH",
                address: "Alamat Sekolah",
                className: "1-A",
                teacher: "Nama Guru",
                headmaster: "Nama Kepala Sekolah"
            });
            const [students, setStudents] = useState([]);
            const [schedule, setSchedule] = useState({});

            // 1. LOAD DATA DARI FIREBASE (Real-time)
            useEffect(() => {
                const dataRef = db.ref('siakad_data');
                dataRef.on('value', (snapshot) => {
                    const val = snapshot.val();
                    if (val) {
                        if (val.school) setSchoolData(val.school);
                        if (val.students) setStudents(val.students);
                        if (val.schedule) setSchedule(val.schedule);
                    }
                    setLoading(false);
                });
                return () => dataRef.off();
            }, []);

            // 2. SIMPAN DATA KE FIREBASE (Auto-save)
            const saveData = (newData) => {
                db.ref('siakad_data').update(newData)
                    .catch(err => console.error("Gagal simpan ke Cloud:", err));
            };

            const handleUpdateSchool = (e) => {
                const { name, value } = e.target;
                const updated = { ...schoolData, [name]: value };
                setSchoolData(updated);
                saveData({ school: updated });
            };

            if (loading) return <div class="h-screen flex items-center justify-center font-bold">Menghubungkan ke Cloud Database...</div>;

            return (
                <div class="min-h-screen flex flex-col md:flex-row">
                    {/* Sidebar */}
                    <nav class="no-print w-full md:w-64 bg-slate-900 text-slate-300 p-6 flex-shrink-0">
                        <div class="flex items-center gap-3 mb-10">
                            <div class="bg-violet-600 p-2 rounded-lg"><Icons.School class="text-white" /></div>
                            <h1 class="font-bold text-xl text-white">SiAkad <span class="text-violet-400">Cloud</span></h1>
                        </div>
                        <div class="space-y-2">
                            <button onClick={() => setActiveTab('profile')} class={`w-full flex items-center gap-3 px-4 py-3 rounded-xl ${activeTab === 'profile' ? 'bg-violet-600 text-white' : 'hover:bg-slate-800'}`}>
                                <Icons.Settings size={20} /> Profil
                            </button>
                            <button onClick={() => setActiveTab('students')} class={`w-full flex items-center gap-3 px-4 py-3 rounded-xl ${activeTab === 'students' ? 'bg-violet-600 text-white' : 'hover:bg-slate-800'}`}>
                                <Icons.Users size={20} /> Siswa
                            </button>
                            <button onClick={() => setActiveTab('schedule')} class={`w-full flex items-center gap-3 px-4 py-3 rounded-xl ${activeTab === 'schedule' ? 'bg-violet-600 text-white' : 'hover:bg-slate-800'}`}>
                                <Icons.Calendar size={20} /> Jadwal
                            </button>
                        </div>
                    </nav>

                    {/* Main Content */}
                    <main class="flex-1 p-6 md:p-10 overflow-y-auto custom-scrollbar">
                        {activeTab === 'profile' && (
                            <Card title="Profil Sekolah & Guru" icon={Icons.Settings}>
                                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                                    <div>
                                        <label class="block text-xs font-bold text-slate-500 uppercase mb-1">Nama Sekolah</label>
                                        <input name="name" value={schoolData.name} onChange={handleUpdateSchool} class="w-full p-2 border rounded-lg focus:ring-2 focus:ring-violet-500 outline-none" />
                                    </div>
                                    <div>
                                        <label class="block text-xs font-bold text-slate-500 uppercase mb-1">Nama Guru</label>
                                        <input name="teacher" value={schoolData.teacher} onChange={handleUpdateSchool} class="w-full p-2 border rounded-lg focus:ring-2 focus:ring-violet-500 outline-none" />
                                    </div>
                                </div>
                            </Card>
                        )}

                        {activeTab === 'students' && (
                            <Card title="Data Siswa" icon={Icons.Users}>
                                <button 
                                    onClick={() => {
                                        const newList = [...students, { id: Date.now(), name: "Siswa Baru" }];
                                        setStudents(newList);
                                        saveData({ students: newList });
                                    }}
                                    class="mb-4 bg-violet-600 text-white px-4 py-2 rounded-lg flex items-center gap-2 hover:bg-violet-700 transition"
                                >
                                    <Icons.Plus size={18} /> Tambah Siswa
                                </button>
                                <ul class="divide-y">
                                    {students.map(s => (
                                        <li key={s.id} class="py-3 flex justify-between items-center group">
                                            <span>{s.name}</span>
                                            <button 
                                                onClick={() => {
                                                    const filtered = students.filter(st => st.id !== s.id);
                                                    setStudents(filtered);
                                                    saveData({ students: filtered });
                                                }}
                                                class="text-red-400 opacity-0 group-hover:opacity-100 transition"
                                            >
                                                <Icons.Trash2 size={18} />
                                            </button>
                                        </li>
                                    ))}
                                </ul>
                            </Card>
                        )}

                        {activeTab === 'schedule' && (
                            <div>
                                <div class="flex justify-between items-center mb-6">
                                    <h2 class="text-2xl font-bold">Jadwal Pelajaran</h2>
                                    <button onClick={() => window.print()} class="no-print bg-slate-800 text-white px-4 py-2 rounded-lg flex items-center gap-2">
                                        <Icons.Printer size={18} /> Cetak
                                    </button>
                                </div>
                                <p class="text-slate-500 mb-4">Data disimpan secara otomatis di Cloud.</p>
                                {/* Implementasi tabel jadwal bisa dilanjutkan di sini sesuai kebutuhan Anda */}
                            </div>
                        )}
                    </main>
                </div>
            );
        };

        const root = ReactDOM.createRoot(document.getElementById('root'));
        root.render(<App />);
    </script>
</body>
</html>
