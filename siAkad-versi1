        const GradeManager = ({ grades, setGrades, students, subjects, assessments, setAssessments, schoolData }) => {
            const [selectedSubject, setSelectedSubject] = useState(subjects[0]?.id || "");
            const [showForm, setShowForm] = useState(false);
            const [formData, setFormData] = useState({ id: null, type: "harian", topic: "", date: new Date().toISOString().split('T')[0] });
            const printRef = useRef();

            const assessmentTypes = [
                { id: 'harian', label: 'Harian (UH)', color: 'bg-blue-50 text-blue-700 border-blue-200' },
                { id: 'tugas', label: 'Tugas', color: 'bg-emerald-50 text-emerald-700 border-emerald-200' },
                { id: 'pts', label: 'PTS (Mid)', color: 'bg-amber-50 text-amber-700 border-amber-200' },
                { id: 'pas', label: 'PAS (Akhir)', color: 'bg-rose-50 text-rose-700 border-rose-200' }
            ];

            const currentAssessments = assessments
                .filter(a => a.subjectId === selectedSubject)
                .sort((a, b) => new Date(a.date) - new Date(b.date));

            const handleSaveAssessment = () => {
                if (!formData.topic) return alert("Materi/Topik penilaian wajib diisi!");
                if (formData.id) {
                    setAssessments(assessments.map(a => a.id === formData.id ? { ...a, ...formData } : a));
                } else {
                    setAssessments([...assessments, { ...formData, id: Date.now().toString(), subjectId: selectedSubject }]);
                }
                setShowForm(false);
                setFormData({ id: null, type: "harian", topic: "", date: new Date().toISOString().split('T')[0] });
            };

            const handleEditClick = (assessment) => { setFormData(assessment); setShowForm(true); };
            const handleDeleteAssessment = (id) => { if(confirm("Hapus agenda penilaian ini? Data nilainya juga akan terhapus.")) setAssessments(assessments.filter(a => a.id !== id)); };

            const handleGrade = (studentId, assessmentId, val) => {
                let numVal = val;
                if (val !== "") {
                    let parsed = parseInt(val, 10);
                    if (isNaN(parsed)) parsed = 0;
                    numVal = Math.max(0, Math.min(100, parsed));
                }
                setGrades(prev => ({
                    ...prev,
                    [studentId]: {
                        ...(prev[studentId] || {}),
                        [assessmentId]: numVal
                    }
                }));
            };

            const handleKeyDown = (e, rowIndex, colIndex) => {
                const numRows = students.length;
                const numCols = currentAssessments.length;

                if (['ArrowUp', 'ArrowDown', 'ArrowLeft', 'ArrowRight', 'Enter'].includes(e.key)) {
                    e.preventDefault();
                    let nextR = rowIndex;
                    let nextC = colIndex;

                    if (e.key === 'ArrowUp') nextR = Math.max(0, rowIndex - 1);
                    if (e.key === 'ArrowDown' || e.key === 'Enter') nextR = Math.min(numRows - 1, rowIndex + 1);
                    if (e.key === 'ArrowLeft') nextC = Math.max(0, colIndex - 1);
                    if (e.key === 'ArrowRight') nextC = Math.min(numCols - 1, colIndex + 1);

                    const nextInput = document.getElementById(`grade-${nextR}-${nextC}`);
                    if (nextInput) {
                        nextInput.focus();
                        nextInput.select();
                    }
                }
            };

            const calcAvg = (studentId) => {
                if(currentAssessments.length === 0) return 0;
                let total = 0, count = 0;
                currentAssessments.forEach(a => {
                    const score = parseFloat(grades[studentId]?.[a.id]);
                    if(!isNaN(score)) { total += score; count++; }
                });
                return count === 0 ? 0 : Math.round(total / count);
            };

            if (subjects.length === 0) return <div className="text-center p-10 bg-white rounded-xl">Silakan tambah Mata Pelajaran terlebih dahulu.</div>;

            return (
                <div className="space-y-6 pb-20">
                    <div className="no-print sticky top-0 bg-slate-50/95 backdrop-blur z-20 pt-4 pb-2 space-y-4">
