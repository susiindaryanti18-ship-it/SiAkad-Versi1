                                            <p className="font-bold text-lg">{s.name}</p>
                                        </div>
                                        <div className="text-right">
                                            <span className="text-xs text-slate-500 uppercase">NISN</span>
                                            <p className="font-mono font-bold text-lg">{s.nis}</p>
                                        </div>
                                    </div>
                                    
                                    <table className="w-full border-collapse border text-sm mb-6">
                                        <thead><tr className="bg-slate-100"><th className="border p-2 text-left w-2/3">Mata Pelajaran</th><th className="border p-2 text-center">Nilai Akhir</th></tr></thead>
                                        <tbody>{subjects.map(sub => (<tr key={sub.id}><td className="border p-2 font-medium">{sub.name}</td><td className="border p-2 text-center font-bold text-lg">{calcScore(s.id, sub.id)}</td></tr>))}</tbody>
                                    </table>
                                    
                                    <div className="border p-3 rounded mb-8">
                                        <h4 className="font-bold text-xs uppercase mb-2">Kehadiran</h4>
                                        <div className="flex gap-4 text-sm">
                                            <span>Hadir: <b>{abs.h}</b></span><span>Sakit: <b>{abs.s}</b></span><span>Ijin: <b>{abs.i}</b></span><span className="text-red-600">Alpha: <b>{abs.a}</b></span>
                                        </div>
                                    </div>
                                    
                                    <div className="mt-8 flex justify-end">
                                        <div className="text-center w-64">
                                            <p className="mb-16">Mengetahui, Wali Kelas</p>
                                            <p className="font-bold underline">{schoolData.teacher}</p>
                                            <p className="text-sm">NIP. {schoolData.nipTeacher}</p>
                                        </div>
                                    </div>
                                    <hr className="no-print my-8 border-dashed"/>
                                </div>
                            );
