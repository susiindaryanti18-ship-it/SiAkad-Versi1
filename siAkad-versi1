                    <div className="space-y-8">{groupedPlans.map(group => (<div key={group.id} className="space-y-4"><h3 className="font-bold text-lg border-b-2 border-violet-100 pb-2">{group.name}</h3><div className="grid grid-cols-1 md:grid-cols-3 gap-4">{group.plans.map(plan => (<Card key={plan.id} className="p-5 flex flex-col h-full"><div className="flex justify-between mb-3"><span className="text-xs bg-slate-100 px-2 py-1 rounded-md">{plan.date}</span></div><h4 className="font-bold mb-2">{plan.topic}</h4><div className="flex justify-end gap-2 border-t pt-3 mt-auto"><button onClick={() => setPrintingPlan(plan)} className="text-slate-600 text-xs font-bold px-2 py-1 rounded hover:bg-slate-100">Cetak</button><button onClick={() => {setFormData(plan); setView('form')}} className="text-blue-600 text-xs font-bold px-2 py-1 rounded hover:bg-blue-50">Edit</button><button onClick={() => handleDelete(plan.id)} className="text-red-600 text-xs font-bold px-2 py-1 rounded hover:bg-red-50">Hapus</button></div></Card>))}</div></div>))}</div>
                </div>
